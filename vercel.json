{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/zendesk/*.js": {
      "maxDuration": 30,
      "includeFiles": "src/data/productData.js"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
