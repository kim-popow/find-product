# Server-side only (Vercel project > Settings > Environment Variables).
# NEVER prefix these with REACT_APP_ and never commit real values.

# Zendesk subdomain: the "acme" in https://acme.zendesk.com
ZENDESK_SUBDOMAIN=

# Sunshine Conversations app id + API key (Admin Center > Apps and integrations > APIs > Conversations API)
SUNCO_APP_ID=
SUNCO_KEY_ID=
SUNCO_SECRET=

# Optional: restrict accepted context tokens to these integration ids (comma separated)
# ZENDESK_ALLOWED_INTEGRATION_IDS=
